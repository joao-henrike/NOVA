APP_ENV=local

# Database
DATABASE_URL=
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cloudstart
DB_USER=cloudstart_admin
DB_PASSWORD=<local-development-password>
DB_CONNECT_TIMEOUT=3

# Google OAuth / OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Apple Sign in with Apple (web flow requires an HTTPS registered domain)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI=https://example.com/api/auth/apple/callback
APPLE_CLIENT_SECRET_TTL_SECONDS=15552000

# CloudStart application session
# Generate with: openssl rand -hex 32
AUTH_JWT_SECRET_KEY=
AUTH_TOKEN_ISSUER=cloudstart-backend
AUTH_TOKEN_AUDIENCE=cloudstart-api
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_STATE_TTL_SECONDS=600

# false for local HTTP development; true in production HTTPS.
AUTH_COOKIE_SECURE=false
