aws_region  = "us-east-1"
environment = "dev"
project_name = "cloudstart"

# Recursos criados pela infraestrutura principal.
vpc_id = "vpc-xxxxxxxxxxxxxxxxx"

private_subnet_ids = [
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-yyyyyyyyyyyyyyyyy",
]

ecs_cluster_arn = "arn:aws:ecs:us-east-1:123456789012:cluster/cloudstart"

frontend_security_group_id = "sg-xxxxxxxxxxxxxxxxx"
alb_security_group_id      = "sg-yyyyyyyyyyyyyyyyy"

# Opcional: listener existente do ALB.
alb_listener_arn = null

# Em produção, prefira informar o digest:
# container_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/cloudstart/frontend@sha256:..."
container_image = null

tags = {
  Owner = "frontend"
}
