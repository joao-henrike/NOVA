# Terraform working directory
.terraform/

# Terraform state
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform plan and variable files that may contain secrets
*.tfplan
*.tfplan.json
*.tfvars
*.tfvars.json
!terraform.tfvars.example
!bootstrap/terraform.tfvars.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Sensitive local/backend configuration
backend.hcl
backend.*.hcl

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Environment files
.env
.env.*
!.env.example

# Generated documentation / local tooling output
tfdoc/
.tmp/

# Python / Node artifacts if auxiliary tooling is added later
__pycache__/
*.py[cod]
node_modules/

# Secrets and certificates
*.pem
*.key
*.p12
*.pfx
secrets/
